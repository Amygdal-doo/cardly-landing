---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CardObject from '../components/CardObject.astro';
import GetApp from '../components/GetApp.astro';
import { COMPANY_URL, SIGN_IN_URL, SITE_URL, STORE_LINKS } from '../lib/site';

/**
 * The home page.
 *
 * One argument, made in order: a handshake should not cost a tree. Then what
 * replaces the paper — the card, how it travels, how you remember the person
 * afterwards, the page it opens — and only then the price. Every feature named
 * here is one the app ships; nothing is a roadmap item.
 */

const TITLE = 'Cardly — the digital business card. A handshake shouldn’t cost a tree.';
const DESCRIPTION =
  'Cardly is the eco-friendly digital business card: share by QR, link, NFC or Apple & Google Wallet, scan paper cards with AI, keep notes and follow-up reminders, and replace your Linktree with one public page.';

/** Sharing is listed by channel because that is how people ask: "can I…?" */
const shareWays = ['QR code', 'Link', 'NFC tap', 'Apple Wallet', 'Google Wallet'];

const features = [
  {
    tab: 'Share',
    title: 'One card, every way to hand it over',
    body:
      'A QR on your screen, a link in a message, a tap of the phone, or a pass in Apple and Google Wallet. It opens in any browser — they don’t need Cardly to read it.',
    wide: true,
  },
  {
    tab: 'Scan',
    title: 'Photograph a paper card. AI does the typing.',
    body:
      'Point the camera at a printed card and Cardly reads the name, title, company, email and phone for you. Scan someone’s Cardly QR and their card is saved whole.',
  },
  {
    tab: 'Remember',
    title: 'Reminders that bring the follow-up back',
    body:
      'Follow up with John on Friday, at the coffee shop, #client, urgent. Every reminder is tied to the person, so nobody you meet goes cold.',
  },
  {
    tab: 'Notes',
    title: 'Notes on the people you meet',
    body:
      'Where you met, what you talked about, what to send. Folders and #tags keep a conference’s worth of contacts findable months later.',
  },
  {
    tab: 'Design',
    title: 'Your colours, your finish, your logo',
    body:
      'Pick colours, patterns and finishes, place your logo and choose a layout. As many cards as you wear hats — personal, company, side project.',
  },
  {
    tab: 'Teams',
    title: 'A company look on every card',
    body:
      'Create your company, invite people by email, and everyone gets a card in your brand. One bill that follows your headcount.',
    full: true,
  },
];

/** The public page, in the order a visitor scrolls it. */
const pageParts = [
  ['Profile photo & banner', 'Your face and your colours, the moment the link opens.'],
  ['One button that matters', '“Book a call”, “See the menu”, “Download the deck” — next to your photo.'],
  ['Posts', 'Links, notes and videos under your card. Pin the three that matter.'],
  ['Carousel', 'Up to five pictures that each say something and go somewhere.'],
  ['All your links', 'LinkedIn, Instagram, GitHub, YouTube and twelve more, as icons.'],
];

const steps = [
  {
    title: 'Make your card',
    body: 'Name, role, company, the ways to reach you. Choose a colour and a finish. About a minute, once.',
  },
  {
    title: 'Hand it over',
    body: 'QR, link, NFC or Wallet. It opens in whatever browser they have — no app, no account.',
  },
  {
    title: 'Follow up',
    body: 'Scan their card back, add a note and a reminder. Change jobs and every card you shared updates itself.',
  },
];

const faqs = [
  {
    q: 'Do the people I meet need the Cardly app?',
    a: 'No. Your card opens in any phone’s browser from a QR code, a link or an NFC tap. They can save you to their contacts with one tap, or keep the whole card in Cardly if they have it.',
  },
  {
    q: 'Can Cardly replace my Linktree?',
    a: 'Yes. Every card has its own public page with your photo, banner, a call-to-action button, your social links, posts and an image carousel — one link for your bio, your email signature and your QR code.',
  },
  {
    q: 'Can I scan paper business cards?',
    a: 'Yes. Photograph a printed card and Cardly reads the name, title, company, email and phone for you, then saves them as a contact you can add notes and reminders to.',
  },
  {
    q: 'Does it work with Apple Wallet and Google Wallet?',
    a: 'Yes. Add your card to Apple Wallet or Google Wallet and show its QR code from the lock screen, even without opening the app.',
  },
  {
    q: 'How is a digital business card better for the planet?',
    a: 'Around ten billion paper business cards are printed every year and most are thrown away within a week. A Cardly card is never printed, never reprinted when your title changes, and never thrown away.',
  },
  {
    q: 'How much does Cardly cost?',
    a: 'One card is free forever, with sharing, scanning, notes and reminders. Pro is $6.99 a month or $59.99 a year for unlimited cards, your logo, finishes, posts and the full public page.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Cardly',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'iOS, Android, Web',
      url: SITE_URL,
      description: DESCRIPTION,
      offers: [
        { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' },
        { '@type': 'Offer', name: 'Pro monthly', price: '6.99', priceCurrency: 'USD' },
        { '@type': 'Offer', name: 'Pro yearly', price: '59.99', priceCurrency: 'USD' },
      ],
      featureList: [
        'Digital business card with QR code, link and NFC sharing',
        'Apple Wallet and Google Wallet passes',
        'AI business card scanner',
        'Contact notes and follow-up reminders',
        'Custom colours, patterns and logo',
        'Public profile page with posts, carousel, banner and call-to-action button',
        'Company cards for teams',
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout title={TITLE} description={DESCRIPTION} ogImage="/assets/app-home.jpg" schema={schema}>
  <Navbar />

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <header class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="chip chip-eco hero-chip">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17 8C8 10 5.9 16.2 3.8 21.4l1.9.7.9-2.3c.5.2 1 .2 1.4.2C19 20 22 3 22 3c-1 2-8 2.3-13 3.2-5 1-7 5.3-7 9.3 0 1.4.5 2.8.9 3.6C3.8 17.4 7 9 17 8z"/></svg>
          The paperless business card
        </p>
        <h1 class="display-hero">A handshake shouldn’t cost&nbsp;a&nbsp;tree.</h1>
        <p class="lede">
          Cardly is your business card, your link-in-bio and your follow-up list in one app. Share it
          by QR, link, NFC or Wallet, scan theirs back, and never print again.
        </p>

        <div class="hero-ctas">
          <a href={`${SIGN_IN_URL}?mode=signup`} class="btn btn-primary btn-lg">
            Create your free card
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <GetApp class="btn btn-secondary btn-lg" fallbackHref="#features" fallbackLabel="See what it does" />
        </div>
        <p class="small tone-tertiary hero-meta">Free for one card · iPhone, Android and the web</p>
      </div>

      <!-- The app itself, with the two things it does after the handshake. -->
      <div class="hero-visual">
        <figure class="phone phone-hero">
          <img src="/assets/app-home.jpg" width="640" height="1389"
               alt="Cardly home screen with a business card, its QR code and a follow-up reminder" fetchpriority="high" />
        </figure>
        <div class="float float-a" aria-hidden="true">
          <span class="float-dot dot-eco"></span>Added to Apple Wallet
        </div>
        <div class="float float-b" aria-hidden="true">
          <span class="float-dot dot-signal"></span>Follow up with John Doe · Fri
        </div>
      </div>
    </div>

    <div class="container">
      <ul class="facts-rule">
        <li><span class="f-k">10 billion</span><span class="f-v">paper cards printed a year</span></li>
        <li><span class="f-k">88%</span><span class="f-v">binned inside a week</span></li>
        <li><span class="f-k">0</span><span class="f-v">apps they need to install</span></li>
        <li><span class="f-k">0</span><span class="f-v">trees for your next handshake</span></li>
      </ul>
    </div>
  </header>

  <!-- ── Features ─────────────────────────────────────────────────────── -->
  <section class="band" id="features">
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow">Everything after hello</p>
        <h2 class="display-xl">Meet someone. Share in a second. Never lose them.</h2>
        <p class="lede">
          Paper cards end up in a drawer. Cardly keeps every introduction alive — shared, saved,
          noted and followed up.
        </p>
      </div>

      <div class="bento">
        {features.map((f) => (
          <article class:list={['tile', { 'tile-wide': f.wide, 'tile-full': f.full }]}>
            <span class="tile-tab">{f.tab}</span>
            <h3 class="display-m">{f.title}</h3>
            <p class="body tone-secondary">{f.body}</p>
            {f.wide && (
              <ul class="ways">
                {shareWays.map((w) => <li class="chip">{w}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── After the meeting: notes and reminders ───────────────────────── -->
  <section class="band band-solid show-band">
    <div class="container show-grid">
      <div class="show-copy">
        <p class="eyebrow">After the handshake</p>
        <h2 class="display-xl">The follow-up is where deals happen.</h2>
        <p class="lede">
          A note on who they are and where you met. A reminder with a date, a place and a tag. Cardly
          brings it back when it matters — not when you happen to find the card again.
        </p>
        <ul class="ticks">
          <li>Reminders by today, upcoming and done, with urgent ones flagged</li>
          <li>Notes in folders, searchable by #tag, company or event</li>
          <li>Every note and reminder attached to the person it’s about</li>
        </ul>
      </div>
      <div class="show-phones">
        <figure class="phone phone-tilt-l">
          <img src="/assets/app-notes.jpg" width="640" height="1389" loading="lazy"
               alt="Cardly notes: a folder for John Doe and a note about meeting him at Web Summit" />
        </figure>
        <figure class="phone phone-tilt-r">
          <img src="/assets/app-reminders.jpg" width="640" height="1389" loading="lazy"
               alt="Cardly reminders: an urgent follow-up with John Doe at a coffee shop, tagged #client" />
        </figure>
      </div>
    </div>
  </section>

  <!-- ── Your page, not a Linktree ────────────────────────────────────── -->
  <section class="band" id="page">
    <div class="container page-grid">
      <!-- The public page, drawn rather than screenshotted so it follows the theme. -->
      <div class="pagemock" aria-hidden="true">
        <div class="pm-banner"></div>
        <div class="pm-row">
          <span class="pm-avatar">AK</span>
          <span class="pm-cta">Book a call</span>
        </div>
        <CardObject name="Amira Kovač" role="Founder" company="Studio North" email="amira@studionorth.co" />
        <div class="pm-socials"><i></i><i></i><i></i><i></i></div>
        <div class="pm-post"><b></b><span><em></em><em></em></span></div>
        <div class="pm-post"><b></b><span><em></em><em></em></span></div>
        <div class="pm-carousel"><i class="on"></i><i></i><i></i></div>
      </div>

      <div>
        <p class="eyebrow">One link for everything</p>
        <h2 class="display-xl">Your card is also your page. Drop the Linktree.</h2>
        <p class="lede">
          Every card opens a page that’s yours — for your bio, your email signature and your QR
          code. It shows who you are and what to do next.
        </p>
        <dl class="parts">
          {pageParts.map(([k, v]) => (
            <div><dt>{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ── How it works ─────────────────────────────────────────────────── -->
  <section class="band" id="how">
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow">How it works</p>
        <h2 class="display-xl">Three steps, then you stop thinking about it.</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display-m">{s.title}</h3>
            <p class="body tone-secondary">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Impact ───────────────────────────────────────────────────────── -->
  <section class="band band-solid eco-band" id="impact">
    <div class="container eco-grid">
      <div>
        <p class="eyebrow eco-eyebrow">Why we built it</p>
        <h2 class="display-xl">New connections don’t need new paper.</h2>
        <p class="lede">
          Ten billion paper business cards are printed every year, and most are thrown away within a
          week. Every card Cardly replaces is one that is never printed, never reprinted when your
          title changes, and never thrown away. Good for business, better for the world.
        </p>
        <div class="eco-ctas">
          <a href="/impact" class="btn btn-primary">See the arithmetic</a>
          <a href={`${SIGN_IN_URL}?mode=signup`} class="btn btn-ghost">Go paperless</a>
        </div>
      </div>
      <div class="calc surface">
        <p class="eyebrow">Per 1,000 people, per year</p>
        <dl class="calc-rows">
          <div><dt>Paper cards printed per person</dt><dd>200</dd></div>
          <div><dt>Cards not printed</dt><dd>200,000</dd></div>
          <div><dt>Sheets of card stock saved</dt><dd>~20,000</dd></div>
          <div class="calc-total"><dt>Trees not felled</dt><dd>~2.4</dd></div>
        </dl>
        <p class="caption tone-tertiary">
          Ten cards to a sheet, 8,333 sheets to a tree. Round numbers, shown so you can check them.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Pricing ──────────────────────────────────────────────────────── -->
  <section class="band" id="pricing">
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow">Pricing</p>
        <h2 class="display-xl">Free for one card. Pro when you want the whole page.</h2>
      </div>

      <div class="plans">
        <article class="plan">
          <h3 class="display-s">Free</h3>
          <p class="price">$0<span>forever</span></p>
          <ul class="plan-list">
            <li>One card, shared by QR, link and NFC</li>
            <li>Scan and save other people’s cards</li>
            <li>Notes and follow-up reminders</li>
          </ul>
          <a href={`${SIGN_IN_URL}?mode=signup`} class="btn btn-secondary btn-block">Create your card</a>
        </article>

        <article class="plan">
          <h3 class="display-s">Pro monthly</h3>
          <p class="price">$6.99<span>a month</span></p>
          <ul class="plan-list">
            <li>Unlimited cards</li>
            <li>Your logo, finishes and patterns</li>
            <li>Posts, carousel, banner and your button</li>
          </ul>
          <a href={`${SIGN_IN_URL}?mode=signup`} class="btn btn-secondary btn-block">Start monthly</a>
        </article>

        <article class="plan plan-featured">
          <span class="chip plan-flag">Save 28%</span>
          <h3 class="display-s">Pro yearly</h3>
          <p class="price">$59.99<span>a year — about $5 a month</span></p>
          <ul class="plan-list">
            <li>Everything in Pro monthly</li>
            <li>Priority support</li>
            <li>Cancel any time</li>
          </ul>
          <a href={`${SIGN_IN_URL}?mode=signup`} class="btn btn-primary btn-block">Go yearly</a>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Teams ────────────────────────────────────────────────────────── -->
  <section class="band band-solid team-band">
    <div class="container team-grid">
      <div>
        <p class="eyebrow">For companies</p>
        <h2 class="display-xl">One company pays. Everyone gets Pro.</h2>
        <p class="lede">
          Create your company, set its look once, and invite people by email. They get a card in your
          brand the moment they accept. You pay per person you invite — your own place is free.
        </p>
        <div class="team-ctas">
          <a href={COMPANY_URL} class="btn btn-primary">Set up your company</a>
          <a href={SIGN_IN_URL} class="btn btn-ghost">Sign in</a>
        </div>
      </div>
      <ul class="team-facts">
        <li><strong>Your brand on every card.</strong> Logo, colours and finish, set once.</li>
        <li><strong>Invite by email.</strong> Opening the link puts them on the team.</li>
        <li><strong>Roles and job titles.</strong> Admins manage, members just get their card.</li>
        <li><strong>A bill that follows the team.</strong> Add someone, it goes up; remove them, it goes down.</li>
      </ul>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────────── -->
  <section class="band" id="faq">
    <div class="container faq-wrap">
      <div class="sec-head">
        <p class="eyebrow">Questions</p>
        <h2 class="display-xl">Digital business cards, answered.</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p class="body tone-secondary">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Close ────────────────────────────────────────────────────────── -->
  <section class="band-tight">
    <div class="container">
      <div class="close">
        <p class="chip chip-eco">Paperless since your first hello</p>
        <h2 class="display-xl">Your next handshake deserves better than paper.</h2>
        <div class="close-ctas">
          <GetApp class="btn btn-primary btn-lg" fallbackHref={`${SIGN_IN_URL}?mode=signup`} fallbackLabel="Create your card" />
          <a href={STORE_LINKS.ios} class="btn btn-secondary btn-lg">App Store</a>
          <a href={STORE_LINKS.android} class="btn btn-secondary btn-lg">Google Play</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────── */
  .hero { position: relative; padding-top: clamp(40px, 7vh, 88px); overflow: hidden; }
  /* A soft field of the app's two colours behind the phone: the green of the
     product and the orange of the card mark. */
  .glow {
    position: absolute; inset: -20% -10% auto auto; width: 70%; height: 90%; pointer-events: none;
    background:
      radial-gradient(40% 40% at 60% 40%, var(--accent-tint-2), transparent 70%),
      radial-gradient(30% 30% at 80% 70%, var(--signal-tint), transparent 70%);
    filter: blur(10px);
  }
  .hero-grid {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(32px, 6vw, 80px); align-items: center;
  }
  .hero-chip { display: inline-flex; align-items: center; gap: 6px; margin: 0 0 var(--space-lg); }
  .hero-chip svg { width: 14px; height: 14px; }
  .hero-copy .display-hero { margin-bottom: var(--space-lg); }
  .hero-ctas { display: flex; gap: var(--space-md); flex-wrap: wrap; margin-top: var(--space-xl); }
  .hero-meta { margin-top: var(--space-base); }

  /* ── Phones ────────────────────────────────────────────────────────── */
  /* The screenshots carry the phone's clock and battery along the top; the
     frame starts just below them so the app is the first thing seen. */
  .phone {
    margin: 0; position: relative; aspect-ratio: 640 / 1250; overflow: hidden;
    border-radius: 34px; border: 8px solid #0B0F14; background: #0B0F14;
    box-shadow: var(--shadow-card), 0 0 0 1px var(--line-2);
  }
  .phone img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: bottom; }
  .hero-visual { position: relative; display: grid; place-items: center; padding: 4% 0 8%; }
  .phone-hero { width: min(300px, 78%); transform: rotate(2deg); }

  .float {
    position: absolute; display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 14px; border-radius: var(--radius-pill);
    background: var(--card); border: 1px solid var(--line-2); box-shadow: var(--shadow-md);
    font-size: 13px; font-weight: 600; color: var(--ink); white-space: nowrap;
    animation: bob 6s ease-in-out infinite;
  }
  .float-a { top: 34%; left: -4%; }
  .float-b { bottom: 14%; right: 0; animation-delay: -3s; }
  .float-dot { width: 8px; height: 8px; border-radius: 50%; }
  .dot-eco { background: var(--success); }
  .dot-signal { background: var(--signal); }
  @keyframes bob { 50% { transform: translateY(-8px); } }

  .facts-rule {
    list-style: none; margin: clamp(40px, 7vh, 80px) 0 0; padding: var(--space-xl) 0;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-lg);
  }
  .facts-rule li { display: flex; flex-direction: column; gap: 4px; }
  .f-k { font-family: var(--font-display); font-weight: 700; font-size: 26px; letter-spacing: -0.03em; color: var(--ink); }
  .f-v { font-size: 13px; line-height: 18px; color: var(--ink-3); }

  /* ── Section heads ─────────────────────────────────────────────────── */
  .sec-head { max-width: 680px; margin-bottom: clamp(32px, 5vw, 56px); }
  .sec-head .eyebrow { margin-bottom: var(--space-base); }
  .sec-head .lede { margin-top: var(--space-base); }

  /* ── Bento: the app's folder tabs on each tile ─────────────────────── */
  .bento { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 52px var(--space-base); padding-top: 30px; }
  .tile {
    position: relative; display: flex; flex-direction: column; gap: var(--space-sm);
    padding: var(--space-xl); background: var(--card);
    border: 1px solid var(--line-2); border-radius: 0 var(--radius-card) var(--radius-card) var(--radius-card);
    transition: transform .2s ease, border-color .2s ease;
  }
  .tile:hover { transform: translateY(-3px); border-color: var(--accent); }
  .tile-wide { grid-column: span 2; background: linear-gradient(135deg, var(--card), var(--accent-tint)); }
  .tile-full { grid-column: 1 / -1; background: linear-gradient(135deg, var(--card), var(--signal-tint)); }
  /* The tab sits on the tile's top edge, like REACH / REMINDERS / POSTS in the app. */
  .tile-tab {
    position: absolute; left: -1px; bottom: 100%;
    padding: 7px 14px 6px; background: var(--card);
    border: 1px solid var(--line-2); border-bottom: 0; border-radius: var(--radius-control) var(--radius-control) 0 0;
    font-family: var(--font-display); font-weight: 600; font-size: 11px; letter-spacing: 1.4px; text-transform: uppercase; color: var(--ink-2);
  }
  .tile:hover .tile-tab { border-color: var(--accent); color: var(--accent-ink); }
  .ways { list-style: none; margin: var(--space-sm) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-sm); }

  /* ── Showcase ──────────────────────────────────────────────────────── */
  .show-band { background: var(--stock-2); border-block: 1px solid var(--line); }
