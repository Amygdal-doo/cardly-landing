---
import { DASHBOARD_URL } from '../lib/site';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found — Cardly" description="That page doesn't exist." noindex>
  <Navbar />

  <main id="main" class="nf">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1 class="display-hero">There's nothing at this address.</h1>
      <p class="lede">
        The link may be old, or it may have a typo in it. Here's where most people are going.
      </p>
      <div class="links">
        <a href="/" class="btn btn-primary">Back to the homepage</a>
        <a href={DASHBOARD_URL} class="btn btn-secondary">Your card</a>
        <a href="/contact" class="btn btn-ghost">Contact us</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .nf { padding-block: var(--band-y) var(--band-y); }
  .nf .eyebrow { margin-bottom: var(--space-base); }
  .nf .lede { margin-top: var(--space-base); }
  .links { display: flex; gap: var(--space-sm); flex-wrap: wrap; margin-top: var(--space-xl); }
</style>
