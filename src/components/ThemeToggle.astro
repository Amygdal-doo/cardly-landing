---
/**
 * Light · System · Dark.
 *
 * Three states, not two, because "system" is a real preference and not the
 * absence of one: a phone that turns dark at sunset should take the site with
 * it. A two-way toggle cannot express that — once you touch it you are pinned
 * to whichever side you landed on, for ever.
 *
 * The CSS is already built for exactly these three. `:root` carries the light
 * palette, the prefers-color-scheme block carries dark but is guarded with
 * :not([data-theme='light']) so an explicit light choice beats a dark OS, and
 * :root[data-theme='dark'] wins in the other direction. All this control does
 * is set or remove that one attribute.
 *
 * The <html> attribute is set by the inline script in Layout.astro, before
 * paint. This component only draws the control and records the choice.
 */
---

<fieldset class="theme-toggle" data-theme-toggle>
  <legend class="sr-only">Colour theme</legend>
  <button type="button" data-set-theme="light" aria-pressed="false" title="Light">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    <span class="sr-only">Light</span>
  </button>
  <button type="button" data-set-theme="system" aria-pressed="true" title="Match system">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2.5" y="4" width="19" height="13" rx="2" />
      <path d="M8.5 21h7" />
    </svg>
    <span class="sr-only">Match system</span>
  </button>
  <button type="button" data-set-theme="dark" aria-pressed="false" title="Dark">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" />
    </svg>
    <span class="sr-only">Dark</span>
  </button>
</fieldset>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 2px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    background: var(--stock-2);
  }

  .theme-toggle button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
    transition: background-color .16s ease, color .16s ease;
  }
  .theme-toggle button svg { width: 15px; height: 15px; }
  .theme-toggle button:hover { color: var(--ink); }
  .theme-toggle button:focus-visible { outline: 2px solid var(--accent, var(--blue)); outline-offset: 2px; }

  /* The selected one is the only filled thing in the control. */
  .theme-toggle button[aria-pressed='true'] {
    background: var(--card);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
  }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  @media (prefers-reduced-motion: reduce) { .theme-toggle button { transition: none; } }
</style>

<script>
  const KEY = 'cardly.theme';

  /** Paint the control to match whatever is stored. */
  function paint(choice: string) {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle] [data-set-theme]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.setTheme === choice)),
    );
  }

  function apply(choice: string) {
    const root = document.documentElement;
    // "system" is the absence of the attribute — that is what lets the
    // prefers-color-scheme block take over again.
    if (choice === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', choice);

    try {
      if (choice === 'system') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, choice);
    } catch {
      // Private browsing refuses storage. The choice still applies to this
      // page; it just will not survive a reload.
    }
    paint(choice);
  }

  let stored = 'system';
  try { stored = localStorage.getItem(KEY) || 'system'; } catch { /* default */ }
  paint(stored);

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle] [data-set-theme]').forEach((b) =>
    b.addEventListener('click', () => apply(b.dataset.setTheme!)),
  );

  // Another tab changed it. Without this the two disagree until a reload.
  window.addEventListener('storage', (e) => {
    if (e.key === KEY) apply(e.newValue || 'system');
  });
</script>
