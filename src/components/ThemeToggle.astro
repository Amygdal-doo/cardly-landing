---
/**
 * Theme picker.
 *
 * Five choices, so this is a <select> rather than the row of buttons it used
 * to be — five targets in a header is a lot of chrome, and a native select
 * brings keyboard support, type-ahead and the platform's own menu for free,
 * on a phone as well as a laptop.
 *
 * Light and dark first because they are what people look for. "Match system"
 * sits last: it is the default, so anybody on it has no reason to hunt for it.
 *
 * The choice is stored as one attribute on <html>. tokens.css does the rest:
 * :root carries light, :root:not([data-theme]) inside the prefers-color-scheme
 * block carries system dark, and each named theme has its own block. The guard
 * is :not([data-theme]) rather than :not([data-theme='light']) precisely so a
 * dark OS cannot override an explicit choice of paper.
 */
---

<label class="theme-picker">
  <span class="sr-only">Colour theme</span>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9" />
    <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none" />
  </svg>
  <select data-theme-select aria-label="Colour theme">
    <option value="light">Light</option>
    <option value="dark">Dark</option>
    <option value="midnight">Midnight</option>
    <option value="paper">Paper</option>
    <option value="system">Match system</option>
  </select>
</label>

<style>
  .theme-picker {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 8px 0 10px;
    height: 32px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    background: var(--stock-2);
    color: var(--ink-2);
    cursor: pointer;
  }
  .theme-picker:hover { color: var(--ink); }
  .theme-picker:focus-within { outline: 2px solid var(--accent, var(--blue)); outline-offset: 2px; }
  .theme-picker svg { width: 15px; height: 15px; flex: none; }

  .theme-picker select {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    padding: 0 2px 0 0;
    cursor: pointer;
  }
  .theme-picker select:focus { outline: none; }
  /* The menu itself is drawn by the OS and does not inherit; name the colours
     so the options are not black-on-black when the page is dark. */
  .theme-picker option { background: var(--card); color: var(--ink); }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>

<script>
  const KEY = 'cardly.theme';
  const NAMED = ['light', 'dark', 'midnight', 'paper'];

  function apply(choice: string) {
    const root = document.documentElement;
    // "system" is the absence of the attribute — that is what hands control
    // back to the prefers-color-scheme block.
    if (NAMED.includes(choice)) root.setAttribute('data-theme', choice);
    else root.removeAttribute('data-theme');

    try {
      if (NAMED.includes(choice)) localStorage.setItem(KEY, choice);
      else localStorage.removeItem(KEY);
    } catch {
      // Private browsing refuses storage; the choice still applies to this page.
    }
    document.querySelectorAll<HTMLSelectElement>('[data-theme-select]').forEach((s) => {
      s.value = NAMED.includes(choice) ? choice : 'system';
    });
  }

  let stored = 'system';
  try { stored = localStorage.getItem(KEY) || 'system'; } catch { /* default */ }
  apply(stored);

  document.querySelectorAll<HTMLSelectElement>('[data-theme-select]').forEach((s) =>
    s.addEventListener('change', () => apply(s.value)),
  );

  // Another tab changed it; without this the two disagree until a reload.
  window.addEventListener('storage', (e) => {
    if (e.key === KEY) apply(e.newValue || 'system');
  });
</script>
